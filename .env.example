# Core
ARGUS_ENV=development
ARGUS_DATABASE_URL=postgres://argus:argus@localhost:5432/argus
ARGUS_MASTER_KEY=replace-with-32-byte-secret

# Execution
ARGUS_DEFAULT_WORKER=codex

# LLM providers
OPENAI_API_KEY=
QWEN_API_KEY=
NVIDIA_API_KEY=

# HTTP write access: distinct random tokens of at least 32 ASCII characters.
# Empty tokens disable the corresponding role. GET endpoints remain readable.
ARGUS_HTTP_ADMIN_TOKEN=
ARGUS_HTTP_DEVELOPER_TOKEN=
ARGUS_HTTP_VIEWER_TOKEN=

# Telegram
ARGUS_TELEGRAM_BOT_TOKEN=
ARGUS_TELEGRAM_WEBHOOK_SECRET=

# Feishu
ARGUS_FEISHU_WEBHOOK_URL=

# Google Chat
ARGUS_GOOGLE_CHAT_WEBHOOK_URL=

# WhatsApp Cloud API
ARGUS_WHATSAPP_ACCESS_TOKEN=
ARGUS_WHATSAPP_PHONE_NUMBER_ID=

# QQ Bot
ARGUS_QQ_ENABLED=false
ARGUS_QQ_APP_ID=
ARGUS_QQ_APP_SECRET=
ARGUS_QQ_BOT_SECRET=
ARGUS_QQ_API_BASE_URL=https://api.sgroup.qq.com
ARGUS_QQ_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
